generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum FitnessGoal {
  BUILD_MUSCLE
  LOSE_FAT
  GET_STRONGER
  IMPROVE_ENDURANCE
  GENERAL_FITNESS
}

enum ExperienceLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum WorkoutPreference {
  GYM
  HOME
  HYBRID
}

enum Difficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum MuscleGroup {
  CHEST
  BACK
  SHOULDERS
  BICEPS
  TRICEPS
  LEGS
  GLUTES
  CORE
  FULL_BODY
}

model User {
  id                String             @id @default(cuid())
  email             String             @unique
  passwordHash      String
  name              String
  weightKg          Float?
  heightCm          Float?
  goal              FitnessGoal        @default(GENERAL_FITNESS)
  experienceLevel   ExperienceLevel    @default(BEGINNER)
  workoutPreference WorkoutPreference  @default(GYM)
  profileImageUrl   String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  histories         WorkoutHistory[]
  exerciseLogs      ExerciseLog[]
  progress          UserProgress[]
}

model WorkoutPlan {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  description String
  level       Difficulty
  daysPerWeek Int
  workouts    Workout[]
  createdAt   DateTime  @default(now())
}

model Workout {
  id          String            @id @default(cuid())
  planId      String
  name        String
  dayIndex    Int
  focus       MuscleGroup[]
  durationMin Int
  plan        WorkoutPlan       @relation(fields: [planId], references: [id], onDelete: Cascade)
  exercises   WorkoutExercise[]
  histories   WorkoutHistory[]
}

model Exercise {
  id            String            @id @default(cuid())
  name          String            @unique
  slug          String            @unique
  muscleGroup   MuscleGroup
  difficulty    Difficulty
  equipment     String
  instructions  String
  youtubeUrl    String
  caloriesPerSet Int              @default(7)
  workouts      WorkoutExercise[]
  logs          ExerciseLog[]
}

model WorkoutExercise {
  id          String   @id @default(cuid())
  workoutId   String
  exerciseId  String
  order       Int
  targetSets  Int
  targetReps  String
  restSeconds Int
  workout     Workout  @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  exercise    Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@unique([workoutId, exerciseId])
}

model WorkoutHistory {
  id          String        @id @default(cuid())
  userId      String
  workoutId   String
  startedAt   DateTime      @default(now())
  completedAt DateTime?
  durationSec Int           @default(0)
  completed   Boolean       @default(false)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  workout     Workout       @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  logs        ExerciseLog[]
}

model ExerciseLog {
  id          String         @id @default(cuid())
  userId      String
  historyId   String
  exerciseId  String
  setNumber   Int
  reps        Int
  weightKg    Float
  completed   Boolean       @default(false)
  createdAt   DateTime      @default(now())
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  history     WorkoutHistory @relation(fields: [historyId], references: [id], onDelete: Cascade)
  exercise    Exercise       @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@unique([historyId, exerciseId, setNumber])
}

model UserProgress {
  id           String   @id @default(cuid())
  userId       String
  date         DateTime @default(now())
  bodyWeightKg Float?
  totalVolume  Float    @default(0)
  workoutsDone Int      @default(0)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
